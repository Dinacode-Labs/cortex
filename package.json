{
  "name": "cortex",
  "version": "0.0.0",
  "private": true,
  "description": "Cortex: memoria de contexto para proyectos software (documental + vectorial + grafo + bi-temporal), con MCP para agentes de IA",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @cortex/database run migrate",
    "db:seed": "tsx apps/cli/src/index.ts seed",
    "mcp": "pnpm --filter @cortex/mcp-server start",
    "web": "pnpm --filter @cortex/web start",
    "cortex": "tsx apps/cli/src/index.ts",
    "cortex:sync": "tsx apps/cli/src/index.ts sync",
    "cortex:link": "tsx apps/cli/src/index.ts link",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dinacode-Labs/cortex.git"
  }
}
