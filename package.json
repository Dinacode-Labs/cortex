{
  "name": "dinacode-cortex",
  "version": "0.0.0",
  "private": true,
  "description": "Dinacode Cortex: plataforma de memoria corporativa de contexto para proyectos software (Mastra + MCP + capa híbrida documental/vectorial/relacional)",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @cortex/database run migrate",
    "db:seed": "pnpm --filter @cortex/core run seed",
    "mcp": "pnpm --filter @cortex/mcp-server start",
    "web": "pnpm --filter @cortex/web start",
    "workflow:capture": "pnpm --filter @cortex/agents demo:capture"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
