{
  "description": "Cortex hooks. They need the `cortex` CLI on your PATH (npm i -g @dinacode/cortex) and a linked project (cortex link). The capture hook detects which agent it is running under, so this same plugin works in Claude Code and Codex. Everything is guarded so a missing CLI never breaks your session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v cortex >/dev/null 2>&1 && cortex hook-context || true",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v cortex >/dev/null 2>&1 && cortex hook-capture || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v cortex >/dev/null 2>&1 && cortex hook-capture || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
