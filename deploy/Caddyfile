# One domain for everything. The alternative we discarded: three subdomains, which triples
# the DNS, the certificates and the URLs each client has to be configured with.
{
	email {$CORTEX_ACME_EMAIL}
}

{$CORTEX_DOMAIN} {
	encode zstd gzip

	# Session transcripts travel whole in the body; 25 MB leaves plenty of room and cuts an
	# outsized upload before it reaches the application.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# handle_path strips the prefix: the server serves at / and does not know it lives under /api.
	handle_path /api/* {
		reverse_proxy server:8787
	}

	# The API serves the installer, but it hangs off the root so the URL stays short.
	handle /install.sh {
		reverse_proxy server:8787
	}

	# MCP speaks over streaming: with buffering, responses arrive in fits and starts, or not at all.
	handle /mcp* {
		reverse_proxy mcp:8788 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format console
	}
}
