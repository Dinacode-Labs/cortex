# Un solo dominio para todo. Alternativa descartada: tres subdominios, que triplica el DNS,
# los certificados y las URLs que hay que configurar en cada cliente.
{
	email {$CORTEX_ACME_EMAIL}
}

{$CORTEX_DOMAIN} {
	encode zstd gzip

	# Los transcripts de sesión viajan enteros en el cuerpo; 25 MB da margen de sobra y
	# corta un envío desmedido antes de que llegue a la aplicación.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# handle_path recorta el prefijo: el servidor sirve en / y no sabe que vive bajo /api.
	handle_path /api/* {
		reverse_proxy server:8787
	}

	# El instalador lo sirve la API, pero cuelga de la raíz para que la URL sea corta.
	handle /install.sh {
		reverse_proxy server:8787
	}

	# El MCP habla por streaming: con buffering, las respuestas llegan a trompicones o no llegan.
	handle /mcp* {
		reverse_proxy mcp:8788 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:8080
	}

	log {
		output stdout
		format console
	}
}
