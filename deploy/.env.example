# Despliegue de Cortex (cópialo a deploy/.env y edítalo). Estos valores se inyectan en
# todos los servicios del docker-compose.

# --- Postgres (servicio interno del compose) ---
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=cortex
# La contraseña DEBE coincidir con POSTGRES_PASSWORD. Host = nombre del servicio (postgres).
DATABASE_URL=postgres://cortex:cambia-esto@postgres:5432/cortex

# --- URL pública (dominio detrás de proxy/HTTPS) ---
# La usa /install.sh y los enlaces; cliente: CORTEX_SERVER_URL / CORTEX_WEB_URL.
CORTEX_PUBLIC_URL=https://cortex.dinacode.com
CORTEX_SERVER_URL=https://cortex.dinacode.com
CORTEX_WEB_URL=https://cortex.dinacode.com

# --- Auth (email + OTP) ---
CORTEX_AUTH_DOMAIN=dinacode.com
CORTEX_ADMIN_EMAIL=ruben@dinacode.com
BREVO_API_KEY=
BREVO_SENDER=no-reply@dinacode.com
BREVO_SENDER_NAME=Dinacode Cortex

# --- Proveedores (embeddings + LLM) ---
EMBEDDINGS_PROVIDER=nan
LLM_PROVIDER=nan
NAN_API_KEY=

# --- Mantenimiento (worker) ---
CORTEX_MAINTAIN_CRON=0 3 * * *
