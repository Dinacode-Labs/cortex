# Deploying Cortex. Copy this to deploy/.env, edit it and protect it:  chmod 600 deploy/.env
# These values are injected into every service in the compose file.
#
# No values from any one company here: this file is the product's template.

# =============================================================================
# IMAGE
# =============================================================================
CORTEX_IMAGE=ghcr.io/dinacode-labs/cortex
# Pin a specific version in production: "latest" means a restart changes version without
# anyone having decided to.
CORTEX_VERSION=0.1.0

# =============================================================================
# DOMAIN AND TLS (Caddy requests and renews the certificate on its own)
# =============================================================================
CORTEX_DOMAIN=cortex.example.com
CORTEX_ACME_EMAIL=infra@example.com
TZ=Europe/Madrid

# =============================================================================
# POSTGRES (an internal service; it publishes no ports)
# =============================================================================
POSTGRES_USER=cortex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cortex
# The password MUST match POSTGRES_PASSWORD. The host is the service name.
DATABASE_URL=postgres://cortex:change-me@postgres:5432/cortex

# =============================================================================
# PUBLIC URLS
# =============================================================================
# The topology is a single host with paths: / the web app, /api the API, /mcp the MCP.
CORTEX_PUBLIC_URL=https://cortex.example.com/api
CORTEX_SERVER_URL=https://cortex.example.com/api
CORTEX_WEB_URL=https://cortex.example.com
CORTEX_MCP_PUBLIC_URL=https://cortex.example.com/mcp
# The oldest CLI this server accepts. Below it, the CLI refuses to write (reading still works).
# Raise it only when a server change genuinely breaks old clients (ADR-0062).
CORTEX_MIN_CLIENT_VERSION=0.1.0

# =============================================================================
# BRANDING
# =============================================================================
CORTEX_BRAND_NAME=Cortex
# An optional logo (SVG). Mount the file into the container and point here.
# CORTEX_BRAND_LOGO_FILE=/app/branding/logo.svg

# =============================================================================
# AUTHENTICATION (email + code)
# =============================================================================
# ⚠️ EMPTY = any email in the world can sign up. In production, set it.
CORTEX_AUTH_DOMAIN=example.com
CORTEX_ADMIN_EMAIL=admin@example.com

# A per-IP limit on sending access codes. `requestOtp` already limits per address; this stops
# a single IP asking for codes for many different addresses, which are real emails to real
# people. The server's general rate limit belongs at the edge, not here.
# CORTEX_AUTH_IP_MAX=10
# CORTEX_AUTH_IP_WINDOW_MIN=15

# --- Transactional email: log | brevo | smtp -------------------------------
# "log" only prints the code: do NOT use it in production, nobody would receive anything.
CORTEX_EMAIL_PROVIDER=smtp
CORTEX_EMAIL_FROM=no-reply@example.com
# CORTEX_EMAIL_FROM_NAME=Cortex
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
# BREVO_API_KEY=          # only if CORTEX_EMAIL_PROVIDER=brevo

# =============================================================================
# INFERENCE PROVIDERS
# =============================================================================
# The server distils sessions with ITS key: the laptops carry none.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# CORTEX_VISION_MODEL=
# The provider's limit is per key, not per endpoint: raise this only if you measure headroom.
# Requests in parallel to the inference provider. Chat, vision, transcription and embeddings
# share this budget because they share a key.
#
# MIND THE ARITHMETIC: the limit is PER PROCESS. A deployment runs several that call the model
# — the API, the maintenance worker, the MCP and the web app — each with its own counter. The
# real ceiling against your key is `processes × this value`. If your provider allows 5 in
# parallel and you have 4 processes, the right value is 1, not 5.
# CORTEX_LLM_CONCURRENCY=4

EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=https://api.example.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Mandatory: it pins the vector schema's dimension. Changing it later forces a reindex.
EMBEDDINGS_DIM=4096

# --- Audio transcription (optional) ----------------------------------------
# CORTEX_STT_BASE_URL=
# CORTEX_STT_API_KEY=
# CORTEX_STT_MODEL=

# =============================================================================
# CAPTURE AND MAINTENANCE
# =============================================================================
# Simultaneous distillations. At 1 on purpose: ten devs closing a session at once are a burst
# of requests against the same key.
CORTEX_CAPTURE_CONCURRENCY=1
CORTEX_CAPTURE_SESSION_MAX_CHARS=150000
CORTEX_MAINTAIN_CRON=0 3 * * *

# Prometheus-format metrics at `/metrics`. Off unless defined: with no token it answers 404.
# It is what lets you find out about the two problems a health check does NOT see, because the
# service keeps answering while they happen: the maintenance worker dying (it has no port) and
# captures starting to fail. Give it a long, random value.
# CORTEX_METRICS_TOKEN=

# --- Network and processes (rarely need touching) ---
# The interface server, web and MCP listen on. Inside a container it has to be 0.0.0.0 so
# Caddy can reach them; outside one, 127.0.0.1 keeps them from being exposed by accident.
# The compose file already sets it to 0.0.0.0. Default: 127.0.0.1.
# CORTEX_BIND_HOST=0.0.0.0
# The file where the maintenance worker leaves its heartbeat. Its healthcheck uses it: the
# worker has no port, so if it dies nothing else notices. Default: /tmp/cortex-worker.heartbeat.
# CORTEX_WORKER_HEARTBEAT_FILE=/tmp/cortex-worker.heartbeat
