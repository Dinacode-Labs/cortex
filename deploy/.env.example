# Despliegue de Cortex. Cópialo a deploy/.env, edítalo y protégelo:  chmod 600 deploy/.env
# Estos valores se inyectan en todos los servicios del compose.
#
# Nada de valores de una empresa concreta aquí: este fichero es la plantilla del producto.

# =============================================================================
# IMAGEN
# =============================================================================
CORTEX_IMAGE=ghcr.io/dinacode-labs/cortex
# Fija una versión concreta en producción: "latest" hace que un reinicio cambie de versión
# sin que nadie lo haya decidido.
CORTEX_VERSION=0.1.0

# =============================================================================
# DOMINIO Y TLS (Caddy pide y renueva el certificado solo)
# =============================================================================
CORTEX_DOMAIN=cortex.example.com
CORTEX_ACME_EMAIL=infra@example.com
TZ=Europe/Madrid

# =============================================================================
# POSTGRES (servicio interno; no publica puertos)
# =============================================================================
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=cortex
# La contraseña DEBE coincidir con POSTGRES_PASSWORD. El host es el nombre del servicio.
DATABASE_URL=postgres://cortex:cambia-esto@postgres:5432/cortex

# =============================================================================
# URLS PÚBLICAS
# =============================================================================
# La topología es un solo host con rutas: / la web, /api la API, /mcp el MCP.
CORTEX_PUBLIC_URL=https://cortex.example.com/api
CORTEX_SERVER_URL=https://cortex.example.com/api
CORTEX_WEB_URL=https://cortex.example.com
CORTEX_MCP_PUBLIC_URL=https://cortex.example.com/mcp
# Versión mínima de CLI que este servidor acepta sin avisar.
CORTEX_MIN_CLIENT_VERSION=0.1.0

# =============================================================================
# MARCA
# =============================================================================
CORTEX_BRAND_NAME=Cortex
# Logo opcional (SVG). Monta el fichero en el contenedor y apunta aquí.
# CORTEX_BRAND_LOGO_FILE=/app/branding/logo.svg

# =============================================================================
# AUTENTICACIÓN (email + código)
# =============================================================================
# ⚠️ VACÍO = cualquier email del mundo puede registrarse. En producción, fíjalo.
CORTEX_AUTH_DOMAIN=example.com
CORTEX_ADMIN_EMAIL=admin@example.com

# --- Email transaccional: log | brevo | smtp -------------------------------
# "log" solo imprime el código: NO lo uses en producción, nadie recibiría nada.
CORTEX_EMAIL_PROVIDER=smtp
CORTEX_EMAIL_FROM=no-reply@example.com
# CORTEX_EMAIL_FROM_NAME=Cortex
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
# BREVO_API_KEY=          # solo si CORTEX_EMAIL_PROVIDER=brevo

# =============================================================================
# PROVEEDORES DE INFERENCIA
# =============================================================================
# El servidor destila las sesiones con SU clave: los portátiles no llevan ninguna.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# CORTEX_VISION_MODEL=
# Límite del proveedor por clave, no por endpoint: sube esto solo si mides que hay margen.
CORTEX_LLM_CONCURRENCY=4

EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=https://api.example.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Obligatorio: fija la dimensión del esquema vectorial. Cambiarlo después obliga a reindexar.
EMBEDDINGS_DIM=4096

# --- Transcripción de audio (opcional) -------------------------------------
# CORTEX_STT_BASE_URL=
# CORTEX_STT_API_KEY=
# CORTEX_STT_MODEL=

# =============================================================================
# CAPTURA Y MANTENIMIENTO
# =============================================================================
# Destilaciones simultáneas. En 1 a propósito: diez devs cerrando sesión a la vez son una
# ráfaga de peticiones contra la misma clave.
CORTEX_CAPTURE_CONCURRENCY=1
CORTEX_CAPTURE_SESSION_MAX_CHARS=150000
CORTEX_MAINTAIN_CRON=0 3 * * *
