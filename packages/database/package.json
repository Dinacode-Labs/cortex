{
  "name": "@cortex/database",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node --conditions=development --import tsx src/migrate-cli.ts",
    "build": "tsc -b tsconfig.build.json",
    "migrate:dist": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@cortex/shared": "workspace:*",
    "postgres": "^3.4.5"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "migrations"
  ]
}
