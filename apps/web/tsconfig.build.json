{
  "$comment": "The real build (tsc -b). The tsconfig.json next to it stays typecheck-only (--noEmit): keeping them apart avoids TS6305 from the project references.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/client/tsconfig.build.json"
    },
    {
      "path": "../../packages/agents/tsconfig.build.json"
    },
    {
      "path": "../../packages/core/tsconfig.build.json"
    },
    {
      "path": "../../packages/database/tsconfig.build.json"
    },
    {
      "path": "../../packages/shared/tsconfig.build.json"
    }
  ]
}
