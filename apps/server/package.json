{
  "name": "@cortex/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "node --conditions=development --import tsx src/index.ts",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@cortex/agents": "workspace:*",
    "@cortex/core": "workspace:*",
    "@cortex/database": "workspace:*",
    "@cortex/shared": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.26",
    "zod": "^3.24.1"
  },
  "license": "Apache-2.0",
  "exports": {
    "./start": {
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  }
}
