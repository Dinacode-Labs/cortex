{
  "name": "@cortex/mcp-server",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "bin": {
    "cortex-mcp": "src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "build": "tsc -b tsconfig.build.json",
    "dev": "node --conditions=development --import tsx src/index.ts",
    "dev:http": "node --conditions=development --import tsx src/http.ts"
  },
  "dependencies": {
    "@cortex/agents": "workspace:*",
    "@cortex/core": "workspace:*",
    "@cortex/database": "workspace:*",
    "@cortex/shared": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.26",
    "zod": "^3.25.76"
  },
  "license": "Apache-2.0",
  "exports": {
    "./start": {
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "development": "./src/http.ts",
      "import": "./dist/http.js"
    }
  }
}
