# Cortex — plantilla de configuración.
#
# Copia a `.env`. Tal cual, arranca: sin claves, sin LLM y con embeddings locales.
# Lo comentado es el valor por defecto; descoméntalo solo para cambiarlo.
# Nunca metas claves reales aquí.
#
# El porqué de cada decisión está en docs/decisions.md, no en este fichero.

DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex
# NODE_ENV=production   # solo se compara con "production": activa la cookie de sesión `secure`

# === LLM ======================================================================
# none | openai-compatible (cualquier endpoint /v1: NaN, Ollama, vLLM, LM Studio) | openrouter
LLM_PROVIDER=none
# LLM_BASE_URL=https://api.nan.builders/v1   # Ollama: http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash                # modelo por defecto de todos los roles
# LLM_ALLOW_NO_KEY=1                         # solo para endpoints locales sin auth
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Modelo por rol: "modelo" o "proveedor:modelo". Roles: CLASSIFIER, GRAPH, RERANKER,
# RETRIEVER, DISTILLER, MERGER, RECONCILER. El retriever es el único cuya salida lee una
# persona (`ask`), así que es donde compensa pagar más.
# CORTEX_MODEL_CLASSIFIER=deepseek-v4-flash
# CORTEX_MODEL_GRAPH=deepseek-v4-flash
# CORTEX_MODEL_RERANKER=deepseek-v4-flash
# CORTEX_MODEL_RECONCILER=deepseek-v4-flash
# CORTEX_MODEL_MERGER=deepseek-v4-flash
# CORTEX_MODEL_DISTILLER=deepseek-v4-flash
# CORTEX_MODEL_RETRIEVER=openrouter:x-ai/grok-4.5

# Llamadas en paralelo al proveedor. Chat, visión, transcripción y embeddings comparten este
# cupo porque comparten clave. Es POR PROCESO: con la API, el worker, el MCP y la web, el techo
# real es `procesos × este valor`. Default: 4.
# CORTEX_LLM_CONCURRENCY=4

# Visión (caption de imágenes, OCR). Vacío usa el modelo de chat, que puede ser text-only y
# fallar en silencio con imágenes. Admite "proveedor:modelo".
# CORTEX_VISION_MODEL=deepseek-v4-flash

# Transcripción. Endpoint aparte porque no todos sirven /audio/transcriptions.
# La clave cae a LLM_API_KEY y luego a OPENAI_API_KEY.
# CORTEX_STT_API_KEY=
# CORTEX_STT_BASE_URL=https://api.openai.com/v1
# CORTEX_STT_MODEL=whisper-1

# Precios para la estimación de coste de /admin/usage. USD por millón de tokens.
# CORTEX_PRICING_JSON={"mi-modelo":{"in":0.1,"out":0.4}}

# === Embeddings ===============================================================
# local (léxico, NO semántico: para arrancar y para los tests) | openai-compatible | openai | voyage
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_BASE_URL=https://api.nan.builders/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=qwen3-embedding
# EMBEDDINGS_DIM=4096          # obligatorio con openai-compatible: fija el esquema vectorial,
#                              # y cambiarlo obliga a re-embeber todo el corpus
# EMBEDDINGS_ALLOW_NO_KEY=1    # solo para endpoints locales sin auth
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIM=3072    # 3-large=3072, 3-small=1536
# VOYAGE_API_KEY=              # voyage-3, 1024 dims, modelo fijo

# === Búsqueda =================================================================
# CORTEX_RERANK=off               # rerank con LLM; activo salvo el valor literal "off"
# CORTEX_SEARCH_TYPE_BOOST=0.15   # cuánto sube una entrada cuyo tipo encaja con la pregunta

# === Servidor y acceso ========================================================
CORTEX_SERVER_PORT=8787
CORTEX_SERVER_URL=http://localhost:8787
CORTEX_WEB_URL=http://localhost:8080
# CORTEX_PUBLIC_URL=            # URL base que anuncia /install.sh; vacío usa el origin
# CORTEX_MCP_URL=               # MCP al que conecta `cortex mcp`; lo dice /client-config

# Dominios permitidos para entrar, separados por comas. VACÍO = cualquier email del mundo
# puede crearse cuenta. Sin default: el producto no conoce tu dominio.
CORTEX_AUTH_DOMAIN=
# Quiénes gestionan permisos y ven todos los proyectos. Coma-separado.
CORTEX_ADMIN_EMAIL=
CORTEX_OTP_TTL_MIN=10
CORTEX_TOKEN_TTL_DAYS=30
CORTEX_OTP_RATE_MAX=5          # códigos por email dentro de la ventana
CORTEX_OTP_RATE_WINDOW_MIN=15
# CORTEX_AUTH_IP_MAX=10        # códigos por IP: evita pedir códigos para muchas direcciones
# CORTEX_AUTH_IP_WINDOW_MIN=15
# CORTEX_UI_TICKET_TTL_SEC=90  # ticket de un solo uso de `cortex ui`
# CORTEX_HOME=                 # sustituye a `~` al buscar ~/.cortex/credentials

# Correo del código de acceso: log (lo imprime, no envía) | brevo | smtp.
# El servidor valida esto al arrancar y no arranca si el proveedor elegido no puede funcionar.
CORTEX_EMAIL_PROVIDER=log
CORTEX_EMAIL_FROM=             # obligatorio con brevo/smtp
# CORTEX_EMAIL_FROM_NAME=      # default: CORTEX_BRAND_NAME
# BREVO_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0                # 1 = TLS desde el inicio (puerto 465)

# Métricas Prometheus en /metrics. Sin token el endpoint responde 404. Sirve para enterarse de
# lo que un chequeo de salud no ve: que el worker muera, o que las capturas empiecen a fallar.
# CORTEX_METRICS_TOKEN=

# === UI web y MCP =============================================================
WEB_PORT=8080
# CORTEX_MCP_PORT=8788
# CORTEX_MCP_AUTH=off            # quita el Bearer de /mcp; solo desarrollo local
# CORTEX_MCP_MAX_SESSIONS=200
# CORTEX_MCP_SESSION_TTL_SEC=1800

# === Marca ====================================================================
# CORTEX_BRAND_NAME=Cortex
# CORTEX_BRAND_LOGO_FILE=/ruta/a/logo.svg
# CORTEX_BRAND_LOGO_SVG=<svg ...></svg>

# === Cliente (CLI y hooks) ====================================================
# CORTEX_ENV_FILE=/ruta/a/.env             # de dónde carga este fichero; default: ./.env
# CORTEX_NPM_PACKAGE=@dinacodelabs/cortex  # lo que instala `cortex upgrade`; para un fork
# CORTEX_HOOK_CTX_CHARS=8000               # presupuesto del contexto que se inyecta al abrir
#                                          # sesión; el servidor lo reparte entre secciones

# === Captura de sesiones ======================================================
# CORTEX_CAPTURE_CONCURRENCY=1              # destilaciones en paralelo en el servidor
# CORTEX_CAPTURE_SESSION_MAX_CHARS=150000   # transcript máximo aceptado (413 por encima)
# CORTEX_CAPTURE_WAIT_MS=120000             # espera máxima con ?wait=1
# CORTEX_SESSIONS_LIMIT=                    # sesiones a procesar en un backfill; vacío = todas
# CORTEX_SESSIONS_MAX_WINDOWS=8             # ventanas por transcript; cada una es una llamada
# CORTEX_SESSIONS_WINDOW_CHARS=9000
# CORTEX_SESSIONS_TURN_CHARS=2500
# Dónde guarda las sesiones cada agente (defaults bajo $HOME):
# CORTEX_CODEX_DIR=~/.codex/sessions
# CORTEX_OPENCODE_DIR=~/.local/share/opencode/storage
# CORTEX_OPENCODE_DB=~/.local/share/opencode/opencode.db
# CORTEX_PI_DIR=~/.pi/agent/sessions
# CORTEX_HERMES_DB=~/.hermes/state.db

# === Conectores (connect-docs, connect-github, connect-notion) ================
# CORTEX_CAPTURE_LLM=1        # clasificar cada item con LLM: tipo fiable a cambio de 1 llamada
# CORTEX_CAPTURE_CHUNK=50     # tamaño de lote
# CORTEX_DOCS_MIN_CHARS=40    # mínimo para ingerir un documento
# CORTEX_NOTION_MIN_BODY=40
# CORTEX_DRY=1                # dry-run del conector de Notion

# === Extracción multimodal ====================================================
# CORTEX_IMAGE_MIN_BYTES=8000   # por debajo, una imagen suele ser un icono
# CORTEX_OCR_MIN_TEXT=120       # menos texto que esto en un PDF = escaneado, va a OCR
# CORTEX_OCR_MAX_PAGES=10
# CORTEX_AUDIO_SEGMENT_SEC=600

# === Dedup y mantenimiento ====================================================
# CORTEX_DEDUP_THRESHOLD=0.82   # por encima, un item se trata como actualización de otro
# CORTEX_DEDUP_NOOP=0.95        # por encima, es el mismo y no se guarda
# CORTEX_DEDUP_MAX_DIST=0.05    # distancia máxima para considerarlos duplicados al reconciliar
# CORTEX_DECAY_DAYS=120         # inactividad tras la que una entrada pasa a obsoleta
# CORTEX_MAINTAIN_CRON=0 3 * * *
# CORTEX_MAINTAIN_ON_START=1
# CORTEX_ENRICH_CONCURRENCY=3
# CORTEX_ENRICH_ONLY_MISSING=1  # salta las entradas que ya tienen grafo

# === Ingesta e indexación (operador) ==========================================
# CORTEX_EMBED_BATCH=32
# CORTEX_INGEST_CONCURRENCY=8
# CORTEX_INGEST_LLM=1
# CORTEX_MAX_CHUNKS=            # tope de chunks al indexar código; vacío = sin tope
# CORTEX_SEED_CONFIRM=1         # el seed hace TRUNCATE: exige este valor literal
