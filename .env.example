# =============================================================================
# Dinacode Cortex — plantilla de configuración
# Copia este fichero a `.env` y ajústalo. Por defecto TODO funciona SIN claves
# (embeddings `local`, LLM `none`): la demo arranca sin configurar nada. Conecta
# un proveedor real (nan/OpenAI/Voyage/OpenRouter) cuando quieras calidad de verdad.
# Los defaults comentados abajo son los del código; descoméntalos solo para cambiarlos.
# Los secretos van vacíos o con placeholder: NUNCA metas claves reales aquí.
# =============================================================================

# --- Base de datos ---
# Postgres con pgvector (ver docker-compose.yml). Puerto host 5433 para no
# colisionar con un Postgres local en 5432.
DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex

# --- Entorno ---
# NODE_ENV: solo se comprueba `=== "production"` (activa la cookie de sesión
# web como `secure`). Vacío/otro valor = desarrollo. Default: sin valor.
# NODE_ENV=

# =============================================================================
# PROVEEDORES: embeddings y LLM
# =============================================================================

# --- Proveedor de embeddings ---
# "local"  -> deterministas en proceso, SIN claves (léxico, NO semántico: solo para
#             arrancar sin claves y tests; NO da relevancia real — ver ADR-0023).
# "openai" -> OPENAI_API_KEY. Default text-embedding-3-large (3072 dims); configurable.
# "voyage" -> VOYAGE_API_KEY (voyage-3, 1024 dims — modelo fijo).
# "nan"    -> nan.builders (qwen3-embedding). ⚠️ EN RETIRADA (perdemos el acceso).
# Recomendado para trabajo real: "openai" (ADR-0023).
EMBEDDINGS_PROVIDER=local
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large  # o text-embedding-3-small (más barato)
# OPENAI_EMBEDDING_DIM=3072                       # 3-large=3072, 3-small=1536

# --- Proveedor LLM (clasificación + síntesis de retrieval, capa @cortex/agents) ---
# "none"       -> sin LLM (por defecto): heurísticas locales.
# "openrouter" -> OPENROUTER_API_KEY. Modelo configurable.
# "nan"        -> nan.builders. ⚠️ EN RETIRADA (perdemos el acceso).
LLM_PROVIDER=none

# --- Claves de proveedor (SECRETOS: déjalas vacías si no usas ese proveedor) ---
# OpenAI (embeddings y STT/whisper). Recomendado (ADR-0023).
# OPENAI_API_KEY=

# OpenRouter (LLM de chat + visión).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro      # modelo LLM por defecto (todos los roles)

# --- Modelo por rol (routing, ADR-0023) ---
# CORTEX_MODEL_<ROL> gana al modelo por defecto para ese agente. Roles: CLASSIFIER,
# GRAPH, RERANKER, RETRIEVER, DISTILLER, MERGER, RECONCILER. Sin fijar → usa el default.
# Routing recomendado (barato para lo mecánico, potente para el juicio y lo visible):
# CORTEX_MODEL_CLASSIFIER=deepseek/deepseek-v4-flash
# CORTEX_MODEL_GRAPH=deepseek/deepseek-v4-flash
# CORTEX_MODEL_RERANKER=deepseek/deepseek-v4-flash
# CORTEX_MODEL_RECONCILER=deepseek/deepseek-v4-pro
# CORTEX_MODEL_MERGER=deepseek/deepseek-v4-pro
# CORTEX_MODEL_DISTILLER=deepseek/deepseek-v4-pro
# CORTEX_MODEL_RETRIEVER=x-ai/grok-4.5

# Voyage (embeddings: voyage-3, dim 1024 — el modelo NO es configurable). Upgrade opcional.
# VOYAGE_API_KEY=

# --- Visión (caption de imágenes / OCR de PDF escaneado) ---
# Usa el proveedor de LLM_PROVIDER, pero con modelo propio (el de chat puede ser
# text-only). Con OpenRouter, apunta a un multimodal. Vacío = usa el modelo de chat.
# CORTEX_VISION_MODEL=qwen/qwen3.5-flash-02-23

# --- STT (transcripción de audio/vídeo, whisper) — endpoint PROPIO ---
# OpenRouter NO sirve STT: por defecto va a OpenAI (whisper-1) con OPENAI_API_KEY.
# Overrides (p.ej. para seguir en nan durante la transición: fijar las tres):
# CORTEX_STT_API_KEY=                            # def: OPENAI_API_KEY
# CORTEX_STT_BASE_URL=https://api.openai.com/v1  # def OpenAI
# CORTEX_STT_MODEL=whisper-1                      # def whisper-1

# nan.builders (⚠️ EN RETIRADA; se puede podar al confirmar la baja).
# NAN_API_KEY=
# NAN_BASE_URL=https://api.nan.builders/v1
# NAN_LLM_MODEL=qwen3.6
# NAN_EMBEDDING_MODEL=qwen3-embedding
# NAN_EMBEDDING_DIM=4096

# --- Búsqueda (rerank de 2ª etapa) ---
# CORTEX_RERANK: rerank LLM en la búsqueda. Activo por defecto; se desactiva con
# el valor literal "off". Default: activo.
# CORTEX_RERANK=off

# =============================================================================
# SERVIDOR HTTP + AUTH (email + OTP)
# =============================================================================

# Puerto del servidor (cortex server). Cliente: CORTEX_SERVER_URL (CLI auth).
CORTEX_SERVER_PORT=8787
CORTEX_SERVER_URL=http://localhost:8787
# URL de la UI web (cortex ui abre /auth/cli con tu token).
CORTEX_WEB_URL=http://localhost:8080
# Dominio(s) permitido(s) para login, coma-separado. ⚠️ VACÍO = CUALQUIER email del mundo
# puede pedir un OTP y crearse cuenta. No hay default: el producto no conoce tu dominio.
# En producción, fíjalo (el servidor avisa al arrancar si está vacío).
CORTEX_AUTH_DOMAIN=
# Admin(s) que gestionan permisos y ven todos los proyectos (coma-separado, puede haber varios).
CORTEX_ADMIN_EMAIL=
CORTEX_OTP_TTL_MIN=10
CORTEX_TOKEN_TTL_DAYS=30
# Anti-spam de OTP: máximo de códigos por email dentro de la ventana (evita email-bombing).
CORTEX_OTP_RATE_MAX=5
CORTEX_OTP_RATE_WINDOW_MIN=15
# TTL en segundos del ticket de un solo uso para el login de la UI (cortex ui). Default: 90.
# CORTEX_UI_TICKET_TTL_SEC=90
# URL pública base que el /install.sh anuncia. Sin valor -> usa el origin de la request.
# CORTEX_PUBLIC_URL=

# --- Brevo (envío de OTP) ---
# Sin BREVO_API_KEY, el código se loguea (modo dev, no envía email). Con clave,
# BREVO_SENDER es OBLIGATORIO (sin default: el remitente depende de tu dominio).
BREVO_API_KEY=
BREVO_SENDER=
# BREVO_SENDER_NAME=                            # def: CORTEX_BRAND_NAME

# =============================================================================
# MARCA (lo que ve el usuario: web, emails, contexto inyectado, CLI)
# =============================================================================
# Nombre visible del producto. Default: Cortex.
# CORTEX_BRAND_NAME=Cortex
# Logo opcional para la cabecera de la web: SVG inline o ruta a un fichero .svg.
# Sin logo se muestra un wordmark de texto con el nombre.
# CORTEX_BRAND_LOGO_FILE=/ruta/a/logo.svg
# CORTEX_BRAND_LOGO_SVG=<svg ...></svg>

# =============================================================================
# UI WEB
# =============================================================================
WEB_PORT=8080

# =============================================================================
# SERVIDOR MCP (Streamable HTTP autenticado)
# =============================================================================
# Puerto del MCP por HTTP. Default: 8788.
# CORTEX_MCP_PORT=8788
# Exigir token Bearer en /mcp. Activo por defecto; se desactiva con el valor
# literal "off" (solo desarrollo local). Default: activo.
# CORTEX_MCP_AUTH=off
# Tope de sesiones MCP concurrentes en memoria. Default: 200.
# CORTEX_MCP_MAX_SESSIONS=200
# TTL de una sesión MCP inactiva, en segundos. Default: 1800 (30 min).
# CORTEX_MCP_SESSION_TTL_SEC=1800

# =============================================================================
# DEDUP / RECONCILIACIÓN (captura)
# =============================================================================
# Umbral de similitud por encima del cual un item se trata como UPDATE de otro. Default: 0.82.
# CORTEX_DEDUP_THRESHOLD=0.82
# Umbral de similitud por encima del cual el item es idéntico (NOOP). Default: 0.95.
# CORTEX_DEDUP_NOOP=0.95
# Distancia coseno máxima para considerar duplicados al reconciliar un proyecto. Default: 0.05.
# CORTEX_DEDUP_MAX_DIST=0.05

# =============================================================================
# MANTENIMIENTO Y CURACIÓN
# =============================================================================
# Días de inactividad tras los que una unidad pasa a `obsolete` (auto-curación). Default: 120.
# CORTEX_DECAY_DAYS=120
# Cron del worker de mantenimiento programado (maintain-worker). Default: "0 3 * * *" (3:00 diario).
# CORTEX_MAINTAIN_CRON=0 3 * * *
# Ejecutar el mantenimiento una vez nada más arrancar el worker. Activo con "1". Default: no.
# CORTEX_MAINTAIN_ON_START=1

# =============================================================================
# ENRIQUECIMIENTO DE GRAFO (enrich)
# =============================================================================
# Concurrencia al enriquecer entradas de un proyecto. Default: 3.
# CORTEX_ENRICH_CONCURRENCY=3
# Enriquecer solo las entradas aún sin grafo (salta las ya enriquecidas). Activo con "1". Default: no.
# CORTEX_ENRICH_ONLY_MISSING=1

# =============================================================================
# INGESTA MASIVA (cortex ingest)
# =============================================================================
# Tamaño de lote al generar embeddings durante la ingesta. Default: 32.
# CORTEX_EMBED_BATCH=32
# Concurrencia de la fase 1 (clasificación/normalización) de la ingesta. Default: 8.
# CORTEX_INGEST_CONCURRENCY=8
# Clasificar cada item con LLM durante la ingesta (más lento y con coste). Activo con "1". Default: no.
# CORTEX_INGEST_LLM=1

# =============================================================================
# INDEXACIÓN DE CÓDIGO (cortex index-code)
# =============================================================================
# Límite de chunks a indexar. Sin valor -> sin límite.
# CORTEX_MAX_CHUNKS=

# =============================================================================
# HOOKS DE SESIÓN
# =============================================================================
# Máximo de caracteres de contexto que inyecta el hook SessionStart. Default: 6000.
# CORTEX_HOOK_CTX_CHARS=6000

# =============================================================================
# CAPTURA DE SESIONES DE AGENTES (connect-sessions / backfill)
# =============================================================================
# Nº máximo de sesiones a procesar. Sin valor -> sin límite.
# CORTEX_SESSIONS_LIMIT=
# Máx. ventanas por transcript. Default: 8.
# CORTEX_SESSIONS_MAX_WINDOWS=8
# Máx. caracteres por ventana de transcript. Default: 9000.
# CORTEX_SESSIONS_WINDOW_CHARS=9000
# Máx. caracteres por turno dentro de una ventana. Default: 2500.
# CORTEX_SESSIONS_TURN_CHARS=2500
# Directorios de almacenamiento de sesiones por agente (defaults en $HOME):
# CORTEX_CODEX_DIR=~/.codex/sessions
# CORTEX_OPENCODE_DIR=~/.local/share/opencode/storage
# CORTEX_HERMES_DB=~/.hermes/state.db

# =============================================================================
# CONECTORES DE DOCUMENTOS / NOTION (cortex connect-docs / connect-notion)
# =============================================================================
# Clasificar cada item con LLM durante la captura por lotes de los conectores
# (connect-docs/github/sessions/notion): tipo fiable (decisiones/constraints/riesgos)
# a cambio de 1 llamada LLM por item. Sin esto, el tipo se pone por heurística y la
# inteligencia la aplica luego `cortex maintain`. Activo con "1". Default: no.
# CORTEX_CAPTURE_LLM=1
# Tamaño de lote al capturar documentos/páginas. Default: 50.
# CORTEX_CAPTURE_CHUNK=50
# Mínimo de caracteres para ingerir un documento. Default: 40.
# CORTEX_DOCS_MIN_CHARS=40
# Mínimo de caracteres del cuerpo de una página de Notion para ingerirla. Default: 40.
# CORTEX_NOTION_MIN_BODY=40
# Modo dry-run del conector de Notion (no escribe). Activo con "1". Default: no.
# CORTEX_DRY=1

# =============================================================================
# EXTRACCIÓN MULTIMODAL (OCR / imágenes / audio)
# =============================================================================
# Tamaño mínimo (bytes) de una imagen para procesarla (caption). Default: 8000.
# CORTEX_IMAGE_MIN_BYTES=8000
# Si un PDF tiene menos de N caracteres de texto se considera escaneado -> OCR. Default: 120.
# CORTEX_OCR_MIN_TEXT=120
# Máximo de páginas a pasar por OCR. Default: 10.
# CORTEX_OCR_MAX_PAGES=10
# Segundos por segmento al trocear audio para la transcripción. Default: 600 (10 min).
# CORTEX_AUDIO_SEGMENT_SEC=600

# =============================================================================
# SEED / DEMO (¡destructivo!)
# =============================================================================
# El seed hace TRUNCATE de las tablas. Requiere el valor literal "1" para proceder.
# CORTEX_SEED_CONFIRM=1
