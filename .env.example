# Cortex — configuration template.
#
# Copy this to `.env`. As it stands, it starts: no keys, no LLM and local embeddings.
# What is commented out is the default value; uncomment it only to change it.
# Never put real keys in here.
#
# The why behind each decision is in docs/decisions.md, not in this file.

DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex
# NODE_ENV=production   # only compared against "production": turns on the `secure` session cookie

# === LLM ======================================================================
# none | openai-compatible (any /v1 endpoint: NaN, Ollama, vLLM, LM Studio) | openrouter
LLM_PROVIDER=none
# LLM_BASE_URL=https://api.nan.builders/v1   # Ollama: http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash                # the default model for every role
# LLM_ALLOW_NO_KEY=1                         # local endpoints with no auth only
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# A model per role: "model" or "provider:model". Roles: CLASSIFIER, GRAPH, RERANKER,
# RETRIEVER, DISTILLER, MERGER, RECONCILER. The retriever is the only one whose output a
# person reads (`ask`), so it is where paying more pays off.
# CORTEX_MODEL_CLASSIFIER=deepseek-v4-flash
# CORTEX_MODEL_GRAPH=deepseek-v4-flash
# CORTEX_MODEL_RERANKER=deepseek-v4-flash
# CORTEX_MODEL_RECONCILER=deepseek-v4-flash
# CORTEX_MODEL_MERGER=deepseek-v4-flash
# CORTEX_MODEL_DISTILLER=deepseek-v4-flash
# CORTEX_MODEL_RETRIEVER=openrouter:x-ai/grok-4.5

# Calls to the provider in parallel. Chat, vision, transcription and embeddings share this
# budget because they share a key. It is PER PROCESS: with the API, the worker, the MCP and
# the web app, the real ceiling is `processes × this value`. Default: 4.
# CORTEX_LLM_CONCURRENCY=4

# Vision (image captioning, OCR). Empty uses the chat model, which may be text-only and fail
# silently on images. It accepts "provider:model".
# CORTEX_VISION_MODEL=deepseek-v4-flash

# Transcription. A separate endpoint because not everyone serves /audio/transcriptions.
# The key falls back to LLM_API_KEY and then to OPENAI_API_KEY.
# CORTEX_STT_API_KEY=
# CORTEX_STT_BASE_URL=https://api.openai.com/v1
# CORTEX_STT_MODEL=whisper-1

# Prices for the cost estimate in /admin/usage. USD per million tokens.
# CORTEX_PRICING_JSON={"my-model":{"in":0.1,"out":0.4}}

# === Embeddings ===============================================================
# local (lexical, NOT semantic: for getting started and for the tests) | openai-compatible | openai | voyage
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_BASE_URL=https://api.nan.builders/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=qwen3-embedding
# EMBEDDINGS_DIM=4096          # mandatory with openai-compatible: it pins the vector schema,
#                              # and changing it forces a re-embedding of the whole corpus
# EMBEDDINGS_ALLOW_NO_KEY=1    # local endpoints with no auth only
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIM=3072    # 3-large=3072, 3-small=1536
# VOYAGE_API_KEY=              # voyage-3, 1024 dims, fixed model

# === Search ===================================================================
# CORTEX_RERANK=off               # LLM rerank; on unless the literal value is "off"
# CORTEX_SEARCH_TYPE_BOOST=0.15   # how much an entry whose type fits the question goes up

# === Server and access ========================================================
CORTEX_SERVER_PORT=8787
CORTEX_SERVER_URL=http://localhost:8787
CORTEX_WEB_URL=http://localhost:8080
# CORTEX_PUBLIC_URL=            # base URL announced by /install.sh; empty uses the origin
# CORTEX_MCP_URL=               # the MCP `cortex mcp` connects to; /client-config states it

# Comma-separated domains allowed in. EMPTY = any email in the world can create an account.
# No default: the product does not know your domain.
CORTEX_AUTH_DOMAIN=
# Who manages permissions and sees every project. Comma-separated.
CORTEX_ADMIN_EMAIL=
CORTEX_OTP_TTL_MIN=10
CORTEX_TOKEN_TTL_DAYS=30
CORTEX_OTP_RATE_MAX=5          # codes per email inside the window
CORTEX_OTP_RATE_WINDOW_MIN=15
# CORTEX_AUTH_IP_MAX=10        # codes per IP: stops someone asking for codes for many addresses
# CORTEX_AUTH_IP_WINDOW_MIN=15
# CORTEX_UI_TICKET_TTL_SEC=90  # the single-use ticket from `cortex ui`
# CORTEX_HOME=                 # replaces `~` when looking for ~/.cortex/credentials
# CORTEX_MIN_CLIENT_VERSION=0.1.0  # the oldest CLI this server accepts; below it, the CLI does
#                                  # not write. Raise it only when a change breaks old clients

# Email for the access code: log (prints it, does not send) | brevo | smtp.
# The server validates this at startup and refuses to start if the chosen provider cannot work.
CORTEX_EMAIL_PROVIDER=log
CORTEX_EMAIL_FROM=             # mandatory with brevo/smtp
# CORTEX_EMAIL_FROM_NAME=      # default: CORTEX_BRAND_NAME
# BREVO_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0                # 1 = TLS from the start (port 465)

# Prometheus metrics at /metrics. With no token the endpoint answers 404. It is there to find
# out what a health check cannot see: the worker dying, or captures starting to fail.
# CORTEX_METRICS_TOKEN=

# === Web UI and MCP ===========================================================
WEB_PORT=8080
# CORTEX_MCP_PORT=8788
# CORTEX_MCP_AUTH=off            # drops the Bearer on /mcp; local development only
# CORTEX_MCP_MAX_SESSIONS=200
# CORTEX_MCP_SESSION_TTL_SEC=1800

# === Branding =================================================================
# CORTEX_BRAND_NAME=Cortex
# CORTEX_BRAND_LOGO_FILE=/path/to/logo.svg
# CORTEX_BRAND_LOGO_SVG=<svg ...></svg>

# === Client (CLI and hooks) ===================================================
# CORTEX_ENV_FILE=/path/to/.env            # where this file is loaded from; default: ./.env
# CORTEX_NPM_PACKAGE=@dinacodelabs/cortex  # what `cortex upgrade` installs; for a fork
# CORTEX_NO_VERSION_CHECK=1                # turns off the new-version notice and the minimum
#                                          # version block (it checks /client-config every 24 h)
# CORTEX_HOOK_CTX_CHARS=8000               # budget for the context injected when a session
#                                          # opens; the server splits it across sections

# === Session capture ==========================================================
# CORTEX_CAPTURE_CONCURRENCY=1              # distillations in parallel on the server
# CORTEX_CAPTURE_SESSION_MAX_CHARS=150000   # largest transcript accepted (413 above it)
# CORTEX_CAPTURE_WAIT_MS=120000             # longest wait with ?wait=1
# CORTEX_SESSIONS_LIMIT=                    # sessions to process in a backfill; empty = all
# CORTEX_SESSIONS_MAX_WINDOWS=8             # windows per transcript; each one is a call
# CORTEX_SESSIONS_WINDOW_CHARS=9000
# CORTEX_SESSIONS_TURN_CHARS=2500
# Where each agent keeps its sessions (defaults under $HOME):
# CORTEX_CODEX_DIR=~/.codex/sessions
# CORTEX_OPENCODE_DIR=~/.local/share/opencode/storage
# CORTEX_OPENCODE_DB=~/.local/share/opencode/opencode.db
# CORTEX_PI_DIR=~/.pi/agent/sessions
# CORTEX_HERMES_DB=~/.hermes/state.db

# === Connectors (connect-docs, connect-github, connect-notion) ================
# CORTEX_CAPTURE_LLM=1        # classify each item with an LLM: a reliable type for 1 call
# CORTEX_CAPTURE_CHUNK=50     # batch size
# CORTEX_DOCS_MIN_CHARS=40    # the minimum for a document to be ingested
# CORTEX_NOTION_MIN_BODY=40
# CORTEX_DRY=1                # dry run for the Notion connector

# === Multimodal extraction ====================================================
# CORTEX_IMAGE_MIN_BYTES=8000   # below this, an image is usually an icon
# CORTEX_OCR_MIN_TEXT=120       # less text than this in a PDF = scanned, it goes to OCR
# CORTEX_OCR_MAX_PAGES=10
# CORTEX_AUDIO_SEGMENT_SEC=600

# === Dedup and maintenance ====================================================
# CORTEX_DEDUP_THRESHOLD=0.82   # above this, an item is treated as an update to another
# CORTEX_DEDUP_NOOP=0.95        # above this, it is the same one and does not get saved
# CORTEX_DEDUP_MAX_DIST=0.05    # the largest distance still counted as a duplicate when reconciling
# CORTEX_DECAY_DAYS=120         # inactivity after which an entry becomes stale
# CORTEX_MAINTAIN_CRON=0 3 * * *
# CORTEX_MAINTAIN_ON_START=1
# CORTEX_ENRICH_CONCURRENCY=3
# CORTEX_ENRICH_ONLY_MISSING=1  # skips entries that already have a graph

# === Ingestion and indexing (operator) ========================================
# CORTEX_EMBED_BATCH=32
# CORTEX_INGEST_CONCURRENCY=8
# CORTEX_INGEST_LLM=1
# CORTEX_MAX_CHUNKS=            # cap on chunks when indexing code; empty = no cap
# CORTEX_SEED_CONFIRM=1         # the seed does a TRUNCATE: it demands this literal value
