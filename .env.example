# =============================================================================
# Cortex — plantilla de configuración
# Copia este fichero a `.env` y ajústalo. Por defecto TODO funciona SIN claves
# (embeddings `local`, LLM `none`): la demo arranca sin configurar nada. Conecta
# un proveedor real (nan/OpenAI/Voyage/OpenRouter) cuando quieras calidad de verdad.
# Los defaults comentados abajo son los del código; descoméntalos solo para cambiarlos.
# Los secretos van vacíos o con placeholder: NUNCA metas claves reales aquí.
# =============================================================================

# --- Base de datos ---
# Postgres con pgvector (ver docker-compose.yml). Puerto host 5433 para no
# colisionar con un Postgres local en 5432.
DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex

# --- Entorno ---
# NODE_ENV: solo se comprueba `=== "production"` (activa la cookie de sesión
# web como `secure`). Vacío/otro valor = desarrollo. Default: sin valor.
# NODE_ENV=

# =============================================================================
# PROVEEDORES: embeddings y LLM
# =============================================================================

# Todo endpoint soportado habla el dialecto OpenAI (/v1/...), así que el proveedor es
# genérico y lo define la config: sirve NaN, Ollama, vLLM, LM Studio o TEI sin tocar código
# (ADR-0024). Los ejemplos de abajo son para NaN.

# --- Proveedor LLM (clasificación, grafo, rerank, destilación, síntesis) ---
# "none"              -> sin LLM (por defecto): heurísticas locales, todo funciona sin claves.
# "openai-compatible" -> LLM_BASE_URL + LLM_API_KEY + LLM_MODEL.
# "openrouter"        -> OPENROUTER_API_KEY + OPENROUTER_MODEL.
# "nan"               -> ALIAS OBSOLETO de openai-compatible con los defaults de NaN.
#                        Sigue funcionando en 0.1.x (con aviso); se retira en 0.2.0.
LLM_PROVIDER=none
# LLM_BASE_URL=https://api.nan.builders/v1       # Ollama: http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash                    # modelo por defecto (todos los roles)
# LLM_ALLOW_NO_KEY=1                             # SOLO para endpoints locales sin auth

# --- Captura de sesiones (destilación en el SERVIDOR, ADR-0025) ---
# Los clientes mandan el transcript condensado y el servidor lo destila: así ningún
# portátil necesita una clave de LLM. Solo aplica al servidor.
# CORTEX_CAPTURE_CONCURRENCY=1            # destilaciones en paralelo (el cupo es por API key)
# CORTEX_CAPTURE_SESSION_MAX_CHARS=150000 # tope de transcript aceptado (413 por encima)
# CORTEX_CAPTURE_WAIT_MS=120000           # espera máxima con ?wait=1

# --- Modelo por rol (routing, ADR-0023/0024) ---
# CORTEX_MODEL_<ROL> gana al modelo por defecto de ese agente. Roles: CLASSIFIER, GRAPH,
# RERANKER, RETRIEVER, DISTILLER, MERGER, RECONCILER. Admite dos formas:
#   "modelo"            -> mismo endpoint, otro modelo
#   "proveedor:modelo"  -> OTRO proveedor solo para ese rol, con sus propias credenciales
# Routing recomendado en NaN (deepseek-v4-flash: 1M ctx, visión, tool calling, 3B tok/mes):
# CORTEX_MODEL_CLASSIFIER=deepseek-v4-flash
# CORTEX_MODEL_GRAPH=deepseek-v4-flash
# CORTEX_MODEL_RERANKER=deepseek-v4-flash
# CORTEX_MODEL_RECONCILER=deepseek-v4-flash      # alternativa de más juicio: glm5.3-flash
# CORTEX_MODEL_MERGER=deepseek-v4-flash
# CORTEX_MODEL_DISTILLER=deepseek-v4-flash
# El retriever es el ÚNICO rol cuya salida ve el usuario (`ask`): si quieres más calidad ahí,
# es el sitio donde compensa pagar. Necesita OPENROUTER_API_KEY.
# CORTEX_MODEL_RETRIEVER=openrouter:x-ai/grok-4.5     # u openrouter:anthropic/claude-sonnet-5
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-pro      # default si LLM_PROVIDER=openrouter

# Límite de llamadas EN PARALELO al proveedor (chat + visión + STT + embeddings comparten
# cupo porque comparten API key). NaN admite 5 concurrentes y 60 rpm. Default: 4.
# Peticiones en paralelo al proveedor de inferencia. Chat, visión, transcripción y embeddings
# comparten este cupo porque comparten clave.
#
# OJO CON LA CUENTA: el límite es POR PROCESO. Un despliegue corre varios que llaman al modelo
# —la API, el worker de mantenimiento, el MCP y la web—, cada uno con su propio contador. El
# techo real contra tu clave es `procesos × este valor`. Si tu proveedor admite 5 en paralelo y
# tienes 4 procesos, el valor correcto es 1, no 5.
# CORTEX_LLM_CONCURRENCY=4

# --- Proveedor de embeddings ---
# "local"             -> en proceso, SIN claves (léxico, NO semántico: solo para arrancar
#                        sin claves y para los tests; no da relevancia real).
# "openai-compatible" -> EMBEDDINGS_BASE_URL + EMBEDDINGS_API_KEY + EMBEDDINGS_MODEL + EMBEDDINGS_DIM.
# "openai"            -> OPENAI_API_KEY (text-embedding-3-large, 3072 dims).
# "voyage"            -> VOYAGE_API_KEY (voyage-3, 1024 dims — modelo fijo).
# "nan"               -> ALIAS OBSOLETO de openai-compatible con los defaults de NaN.
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_BASE_URL=https://api.nan.builders/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=qwen3-embedding
# EMBEDDINGS_DIM=4096            # OBLIGATORIO con openai-compatible: fija el esquema vectorial.
#                                # Cambiar de modelo/dimensión obliga a re-embeder el corpus.
# EMBEDDINGS_ALLOW_NO_KEY=1      # SOLO para endpoints locales sin auth
# OPENAI_API_KEY=                                 # proveedor "openai"
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large   # o text-embedding-3-small (más barato)
# OPENAI_EMBEDDING_DIM=3072                       # 3-large=3072, 3-small=1536
# VOYAGE_API_KEY=

# --- Visión (caption de imágenes / OCR de PDF escaneado) ---
# Mismo endpoint que el LLM de chat pero con modelo propio, porque el de chat puede ser
# text-only y la ingesta de imágenes fallaría en silencio. Admite "proveedor:modelo".
# Vacío = usa el modelo de chat.
# CORTEX_VISION_MODEL=deepseek-v4-flash

# --- STT (transcripción de audio/vídeo, whisper) — endpoint PROPIO ---
# Va aparte porque no todos los proveedores sirven /audio/transcriptions (OpenRouter no).
# La clave cae a LLM_API_KEY y luego a OPENAI_API_KEY si no se fija.
# CORTEX_STT_API_KEY=
# CORTEX_STT_BASE_URL=https://api.nan.builders/v1   # def: https://api.openai.com/v1
# CORTEX_STT_MODEL=whisper                          # def: whisper-1

# --- Precios (estimación de coste en /usage) ---
# La tabla vive en código (packages/core/src/usage.ts) y los precios cambian rápido: esto
# permite corregir uno o dar de alta un modelo sin desplegar. USD por 1M tokens.
# CORTEX_PRICING_JSON={"mi-modelo":{"in":0.1,"out":0.4}}

# --- Alias obsoleto `nan` (compatibilidad 0.1.x; se retira en 0.2.0) ---
# Con LLM_PROVIDER=nan / EMBEDDINGS_PROVIDER=nan estas variables siguen funcionando y se
# traducen a las genéricas de arriba (con un aviso por consola). Para configuraciones
# nuevas usa LLM_* y EMBEDDINGS_*.
# NAN_API_KEY=
# NAN_BASE_URL=https://api.nan.builders/v1
# NAN_LLM_MODEL=deepseek-v4-flash
# NAN_EMBEDDING_MODEL=qwen3-embedding
# NAN_EMBEDDING_DIM=4096

# --- Búsqueda (rerank de 2ª etapa) ---
# CORTEX_RERANK: rerank LLM en la búsqueda. Activo por defecto; se desactiva con
# el valor literal "off". Default: activo.
# CORTEX_RERANK=off

# =============================================================================
# SERVIDOR HTTP + AUTH (email + OTP)
# =============================================================================

# Puerto del servidor (cortex server). Cliente: CORTEX_SERVER_URL (CLI auth).
CORTEX_SERVER_PORT=8787
CORTEX_SERVER_URL=http://localhost:8787
# MCP al que se conecta `cortex mcp`. Por defecto lo dice el servidor en /client-config;
# esto solo hace falta para apuntar a otro sitio (túnel, entorno de pruebas).
# CORTEX_MCP_URL=http://localhost:8788/mcp
# Sustituye a `~` al buscar ~/.cortex/credentials (sesión aparte en pruebas).
# CORTEX_HOME=
# URL de la UI web (cortex ui abre /auth/cli con tu token).
CORTEX_WEB_URL=http://localhost:8080
# Dominio(s) permitido(s) para login, coma-separado. ⚠️ VACÍO = CUALQUIER email del mundo
# puede pedir un OTP y crearse cuenta. No hay default: el producto no conoce tu dominio.
# En producción, fíjalo (el servidor avisa al arrancar si está vacío).
CORTEX_AUTH_DOMAIN=
# Admin(s) que gestionan permisos y ven todos los proyectos (coma-separado, puede haber varios).

# Límite por IP del envío de códigos de acceso. `requestOtp` ya limita por dirección; esto evita
# que desde una sola IP se pidan códigos para muchas direcciones distintas, que son correos de
# verdad a gente de verdad. El límite general del servidor va en el borde, no aquí.
# CORTEX_AUTH_IP_MAX=10
# CORTEX_AUTH_IP_WINDOW_MIN=15
CORTEX_ADMIN_EMAIL=
CORTEX_OTP_TTL_MIN=10
CORTEX_TOKEN_TTL_DAYS=30
# Anti-spam de OTP: máximo de códigos por email dentro de la ventana (evita email-bombing).
CORTEX_OTP_RATE_MAX=5
CORTEX_OTP_RATE_WINDOW_MIN=15
# TTL en segundos del ticket de un solo uso para el login de la UI (cortex ui). Default: 90.
# CORTEX_UI_TICKET_TTL_SEC=90
# URL pública base que el /install.sh anuncia. Sin valor -> usa el origin de la request.
# CORTEX_PUBLIC_URL=

# --- Email transaccional (envío del OTP) ---
# "log"   -> imprime el código por consola y NO envía (default sin configurar nada;
#            sirve para probar el login sin credenciales, pero NO en producción).
# "brevo" -> API de Brevo. Requiere BREVO_API_KEY.
# "smtp"  -> SMTP genérico (nodemailer). Requiere SMTP_HOST.
# El servidor VALIDA esto al arrancar: si el proveedor elegido no puede funcionar, no
# arranca (mejor eso que descubrirlo cuando alguien no puede entrar).
CORTEX_EMAIL_PROVIDER=log
# Remitente. Obligatorio con brevo/smtp; sin default (depende de tu dominio).
CORTEX_EMAIL_FROM=
# CORTEX_EMAIL_FROM_NAME=                       # def: CORTEX_BRAND_NAME
# BREVO_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                                 # 465 activa TLS implícito solo
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0                                 # 1 = TLS desde el inicio (puerto 465)
# Nombres antiguos, aceptados como alias del remitente: BREVO_SENDER, BREVO_SENDER_NAME.

# =============================================================================
# MARCA (lo que ve el usuario: web, emails, contexto inyectado, CLI)
# =============================================================================
# Nombre visible del producto. Default: Cortex.
# CORTEX_BRAND_NAME=Cortex
# Logo opcional para la cabecera de la web: SVG inline o ruta a un fichero .svg.
# Sin logo se muestra un wordmark de texto con el nombre.
# CORTEX_BRAND_LOGO_FILE=/ruta/a/logo.svg
# CORTEX_BRAND_LOGO_SVG=<svg ...></svg>

# =============================================================================
# UI WEB
# =============================================================================
WEB_PORT=8080

# =============================================================================
# SERVIDOR MCP (Streamable HTTP autenticado)
# =============================================================================
# Puerto del MCP por HTTP. Default: 8788.
# CORTEX_MCP_PORT=8788
# Exigir token Bearer en /mcp. Activo por defecto; se desactiva con el valor
# literal "off" (solo desarrollo local). Default: activo.
# CORTEX_MCP_AUTH=off
# Tope de sesiones MCP concurrentes en memoria. Default: 200.
# CORTEX_MCP_MAX_SESSIONS=200
# TTL de una sesión MCP inactiva, en segundos. Default: 1800 (30 min).
# CORTEX_MCP_SESSION_TTL_SEC=1800

# =============================================================================
# DEDUP / RECONCILIACIÓN (captura)
# =============================================================================
# Umbral de similitud por encima del cual un item se trata como UPDATE de otro. Default: 0.82.
# CORTEX_DEDUP_THRESHOLD=0.82
# Umbral de similitud por encima del cual el item es idéntico (NOOP). Default: 0.95.
# CORTEX_DEDUP_NOOP=0.95
# Distancia coseno máxima para considerar duplicados al reconciliar un proyecto. Default: 0.05.
# CORTEX_DEDUP_MAX_DIST=0.05

# =============================================================================
# MANTENIMIENTO Y CURACIÓN
# =============================================================================
# Días de inactividad tras los que una unidad pasa a `obsolete` (auto-curación). Default: 120.
# CORTEX_DECAY_DAYS=120
# Cron del worker de mantenimiento programado (maintain-worker). Default: "0 3 * * *" (3:00 diario).
# CORTEX_MAINTAIN_CRON=0 3 * * *
# Ejecutar el mantenimiento una vez nada más arrancar el worker. Activo con "1". Default: no.
# CORTEX_MAINTAIN_ON_START=1

# =============================================================================
# ENRIQUECIMIENTO DE GRAFO (enrich)
# =============================================================================
# Concurrencia al enriquecer entradas de un proyecto. Default: 3.
# CORTEX_ENRICH_CONCURRENCY=3
# Enriquecer solo las entradas aún sin grafo (salta las ya enriquecidas). Activo con "1". Default: no.
# CORTEX_ENRICH_ONLY_MISSING=1

# =============================================================================
# INGESTA MASIVA (cortex ingest)
# =============================================================================
# Tamaño de lote al generar embeddings durante la ingesta. Default: 32.
# CORTEX_EMBED_BATCH=32
# Concurrencia de la fase 1 (clasificación/normalización) de la ingesta. Default: 8.
# CORTEX_INGEST_CONCURRENCY=8
# Clasificar cada item con LLM durante la ingesta (más lento y con coste). Activo con "1". Default: no.
# CORTEX_INGEST_LLM=1

# =============================================================================
# INDEXACIÓN DE CÓDIGO (cortex index-code)
# =============================================================================
# Límite de chunks a indexar. Sin valor -> sin límite.
# CORTEX_MAX_CHUNKS=

# =============================================================================
# HOOKS DE SESIÓN
# =============================================================================
# Presupuesto de caracteres del contexto que inyecta el hook SessionStart. Default: 6000.
# No es una tijera: el servidor lo reparte entre secciones (decisiones, restricciones,
# riesgos, deuda, convenciones) para que llegue algo de cada tipo. Ver ADR-0049.
# CORTEX_HOOK_CTX_CHARS=6000

# =============================================================================
# CAPTURA DE SESIONES DE AGENTES (connect-sessions / backfill)
# =============================================================================
# Nº máximo de sesiones a procesar. Sin valor -> sin límite.
# CORTEX_SESSIONS_LIMIT=
# Máx. ventanas por transcript. Default: 8.
# CORTEX_SESSIONS_MAX_WINDOWS=8
# Máx. caracteres por ventana de transcript. Default: 9000.
# CORTEX_SESSIONS_WINDOW_CHARS=9000
# Máx. caracteres por turno dentro de una ventana. Default: 2500.
# CORTEX_SESSIONS_TURN_CHARS=2500
# Directorios de almacenamiento de sesiones por agente (defaults en $HOME):
# CORTEX_CODEX_DIR=~/.codex/sessions
# CORTEX_OPENCODE_DIR=~/.local/share/opencode/storage
# CORTEX_HERMES_DB=~/.hermes/state.db

# =============================================================================
# CONECTORES DE DOCUMENTOS / NOTION (cortex connect-docs / connect-notion)
# =============================================================================
# Clasificar cada item con LLM durante la captura por lotes de los conectores
# (connect-docs/github/sessions/notion): tipo fiable (decisiones/constraints/riesgos)
# a cambio de 1 llamada LLM por item. Sin esto, el tipo se pone por heurística y la
# inteligencia la aplica luego `cortex maintain`. Activo con "1". Default: no.
# CORTEX_CAPTURE_LLM=1
# Tamaño de lote al capturar documentos/páginas. Default: 50.
# CORTEX_CAPTURE_CHUNK=50
# Mínimo de caracteres para ingerir un documento. Default: 40.
# CORTEX_DOCS_MIN_CHARS=40
# Mínimo de caracteres del cuerpo de una página de Notion para ingerirla. Default: 40.
# CORTEX_NOTION_MIN_BODY=40
# Modo dry-run del conector de Notion (no escribe). Activo con "1". Default: no.
# CORTEX_DRY=1

# =============================================================================
# EXTRACCIÓN MULTIMODAL (OCR / imágenes / audio)
# =============================================================================
# Tamaño mínimo (bytes) de una imagen para procesarla (caption). Default: 8000.
# CORTEX_IMAGE_MIN_BYTES=8000
# Si un PDF tiene menos de N caracteres de texto se considera escaneado -> OCR. Default: 120.
# CORTEX_OCR_MIN_TEXT=120
# Máximo de páginas a pasar por OCR. Default: 10.
# CORTEX_OCR_MAX_PAGES=10
# Segundos por segmento al trocear audio para la transcripción. Default: 600 (10 min).
# CORTEX_AUDIO_SEGMENT_SEC=600

# =============================================================================
# SEED / DEMO (¡destructivo!)
# =============================================================================
# El seed hace TRUNCATE de las tablas. Requiere el valor literal "1" para proceder.
# CORTEX_SEED_CONFIRM=1

# Métricas en formato Prometheus en `/metrics`. Apagado si no se define: sin token responde
# 404. Es lo que permite enterarse de los dos problemas que un chequeo de salud NO ve, porque
# el servicio sigue respondiendo mientras pasan: que el worker de mantenimiento muera (no
# tiene puerto) y que las capturas empiecen a fallar. Ponle un valor largo y aleatorio.
# CORTEX_METRICS_TOKEN=
