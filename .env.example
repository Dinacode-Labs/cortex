# --- Base de datos ---
# Postgres con pgvector (ver docker-compose.yml). Puerto host 5433 para no
# colisionar con un Postgres local en 5432.
DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex

# --- Proveedor de embeddings ---
# "local"  -> embeddings deterministas en proceso, SIN claves (por defecto, para
#             que la demo arranque sin configurar nada). No son semánticos: solo
#             sirven para demostrar el cableado de búsqueda vectorial.
# "openai" -> requiere OPENAI_API_KEY (text-embedding-3-small, 1536 dims).
# "voyage" -> requiere VOYAGE_API_KEY (voyage-3, 1024 dims).
EMBEDDINGS_PROVIDER=local
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# --- Proveedor LLM (clasificación, resúmenes, síntesis de retrieval) ---
# Necesario para los agentes Mastra. Sin clave, los agentes usan heurísticas
# locales de respaldo donde sea posible.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
