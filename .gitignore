# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data / model caches
.data/
.cache/
.models/

# Mastra
.mastra/

# Corporate / internal material: it lives in Dinacode-Labs/ai-toolbelt (private), never here.
# See ADR-0026. These rules exist so it does not come back by accident.
.od-skills/
docs/assets/
docs/internal/
docs/workshop-*
*.artifact.json
dinacode-*.md
config/skills/*/*.zip
# Local Pi runtime state
.atl/

# The link between THIS folder and a Cortex project. It belongs to each clone, not to the
# repository (ADR-0059): whoever clones this and wants their own memory should not have to
# fight a versioned file. `cortex link` creates it on its own.
.cortex.json
# The agent rules for this repository are not versioned here (ADR-0071). A checkout that wants them
# gets `.claude/` as a symlink or a copy, and nothing under it may be re-included.
.claude/
