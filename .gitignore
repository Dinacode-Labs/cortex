# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data / model caches
.data/
.cache/
.models/

# Mastra
.mastra/

# Material corporativo / interno: vive en Dinacode-Labs/ai-toolbelt (privado), nunca aquí.
# Ver ADR-0026. Estas reglas existen para que no vuelva por accidente.
.od-skills/
docs/assets/
docs/internal/
docs/workshop-*
*.artifact.json
dinacode-*.md
config/skills/*/*.zip
# Local Pi runtime state
.atl/

# El vínculo de ESTA carpeta con un proyecto de Cortex. Es de cada clon, no del repositorio
# (ADR-0059): quien clone esto y quiera su propia memoria no debería tener que pelearse con un
# fichero versionado. Se crea solo con `cortex link`.
.cortex.json
# Lo que Cortex instala en Claude Code para ESTE repo (reglas, comando y skill) sí se versiona:
# es parte de cómo se trabaja aquí (ADR-0064). Hace falta decirlo porque el .gitignore global de
# casi cualquier máquina ignora `.claude/`, y una reinclusión no vale si el directorio que la
# contiene sigue excluido: hay que desexcluir el directorio primero. Lo personal
# (settings.local.json) se queda fuera por no estar en la lista.
!.claude/
!.claude/rules/
!.claude/rules/*.md
!.claude/commands/
!.claude/commands/*.md
!.claude/skills/
!.claude/skills/**
